{
  "name": "searchkeep-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** --filter ./apps/cloudflare run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm run lint:deps && pnpm run lint:format",
    "lint:deps": "depcruise packages apps --config .dependency-cruiser.cjs",
    "lint:format": "prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r run test",
    "dev": "pnpm --filter @searchkeep/cloudflare run dev"
  },
  "devDependencies": {}
}
