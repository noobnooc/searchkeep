{
  "name": "@searchkeep/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Marketing site and documentation for Searchkeep (searchkeep.dev).",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/embed-build.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "pnpm run check",
    "deploy": "wrangler deploy",
    "render:assets": "node scripts/render-assets.mjs"
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "wrangler": "^4.157.0"
  }
}
